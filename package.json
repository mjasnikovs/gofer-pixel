{
    "name": "gofer-pixel",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit --pretty false",
        "lint": "eslint . --quiet --cache",
        "lint:fix": "eslint . --fix --quiet --cache",
        "format": "prettier --write . --log-level warn --cache",
        "format:check": "prettier --check . --log-level warn --cache",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "check": "bun run --silent format:check && bun run --silent lint && bun run --silent typecheck && bun run --silent test",
        "preview": "vite preview",
        "astryx": "bun node_modules/@astryxdesign/cli/bin/astryx.mjs",
        "theme": "bun run --silent astryx -- theme build src/theme/theme.ts --out src/theme/gofer-pixel-theme.css",
        "test:browser": "playwright test",
        "clip": ".venv/bin/python py/clipserve.py"
    },
    "dependencies": {
        "@astryxdesign/core": "0.2.0",
        "@astryxdesign/theme-neutral": "0.2.0",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.2.0",
        "@eslint/js": "10.0.1",
        "@happy-dom/global-registrator": "^20.11.1",
        "@playwright/test": "1.60.0",
        "@types/bun": "latest",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.3",
        "globals": "17.8.0",
        "playwright": "1.60.0",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0",
        "vite": "8.2.0"
    }
}
